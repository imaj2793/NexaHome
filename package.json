{
  "name": "nexahome",
  "version": "0.1.0",
  "private": true,
  "description": "NexaHome \u2014 open-source smart home platform with Nexa AI assistant",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "db:generate": "pnpm --filter @nexahome/api prisma:generate",
    "db:migrate": "pnpm --filter @nexahome/api prisma:migrate",
    "db:seed": "pnpm --filter @nexahome/api prisma:seed",
    "db:studio": "pnpm --filter @nexahome/api prisma:studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:seed": "docker compose run --rm migrate pnpm exec prisma db seed",
    "docker:images": "docker images nexahome/*",
    "db:seed:demo": "pnpm --filter @nexahome/api prisma:seed:demo",
    "db:seed:demo:reset": "pnpm --filter @nexahome/api prisma:seed:demo:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
