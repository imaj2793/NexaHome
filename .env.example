# Salin ke `.env` (dihapus dari git) lalu sesuaikan.
#   cp .env.example .env
# Nilai yang sama juga dibaca `docker compose` untuk image produksi.

# ── Database (lokal) ────────────────────────────────────
DATABASE_URL="postgresql://nexahome:nexahome@localhost:5432/nexahome?schema=public"

# Dipakai docker compose untuk membuat container postgres. Saat compose
# berjalan, API memakai DATABASE_URL versi container (host `postgres`).
POSTGRES_USER="nexahome"
POSTGRES_PASSWORD="nexahome"
POSTGRES_DB="nexahome"
POSTGRES_PORT=5432

# ── Authentication ──────────────────────────────────────
# WAJIB diganti di produksi: nilai "change-me-in-production" ditolak oleh
# validateEnv, dan panjang minimal 32 karakter.
# Generate: openssl rand -hex 32
JWT_SECRET="change-me-in-production"

# Kunci enkripsi kredensial integrasi (§12). Dipakai sebagai passphrase yang
# diperpanjang ke kunci AES-256-GCM lewat scrypt (minimal 16 karakter), dan
# TIDAK pernah dikirim ke frontend. Mengganti nilai ini membuat kredensial
# yang tersimpan lama tidak bisa dibaca lagi — simpan salinannya.
# Buat dengan: openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY="ganti-dengan-hasil-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_DAYS=30

# ── Security ────────────────────────────────────────────
# Rate limit endpoint auth (per IP+route). Default 10 permintaan / 60 detik.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Set 1 bila API berada di belakang reverse proxy (nginx/traefik).
TRUST_PROXY=0

# ── Server ──────────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000
# Origin browser yang boleh memanggil API (pisahkan dengan koma untuk multi).
CORS_ORIGIN="http://localhost:3000"
# Di-inline ke bundle browser saat build Next.js, jadi untuk docker compose
# nilai ini jadi build-arg (lihat docker-compose.yml).
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# ── AI Provider (chat) ──────────────────────────────────
# "mock" = dummy tanpa network; "deepseek"/"openai" = OpenAI-compatible (butuh baseUrl + key).
AI_PROVIDER="mock"
AI_API_KEY=""
AI_BASE_URL="https://api.deepseek.com/v1"
AI_MODEL="deepseek-chat"

# ── STT lokal (Whisper) ─────────────────────────────────
# whisper.cpp dijalankan lokal di CPU (tanpa API eksternal). Hanya berlaku untuk
# machine yang menjalankan whisper — di dalam image Docker nilainya kosong
# karena biner/model tidak dibundel.
# PENTING: API memverifikasi file model benar-benar ada. Path placeholder
# membuat STT nonaktif (status "belum dikonfigurasi"), bukan error saat dipakai.
WHISPER_BIN="whisper-cli"
WHISPER_MODEL=""
WHISPER_LANG="id"

# ── Integrasi perangkat ─────────────────────────────────
# Nilai mode HARUS salah satu dari yang tertulis (selainnya API gagal start):
#   MQTT_MODE    : mock | mqtt    (butuh MQTT_URL)
#   TASMOTA_MODE : mock | http
# "mock" berarti TIDAK ADA koneksi ke perangkat — bukan perangkat simulasi.
# Scan dalam mode mock selalu kosong; hanya mode nyata yang melaporkan
# perangkat yang benar-benar ditemukan.
# Di docker compose MQTT_MODE dipaksa "mqtt" karena broker mosquitto ikut
# dinyalakan. Tasmota tetap mock: mDNS ke jaringan LAN sulit dijangkau dari
# container bridge.
#
# Broker compose punya tiga listener:
#   mqtt://localhost:1883  plaintext, hanya loopback host
#   mqtts://localhost:8883 TLS, wajib password
#   wss://localhost:443    TLS + WebSocket, wajib password
#
# MQTT_USERNAME/MQTT_PASSWORD TIDAK diisi manual: scripts/mqtt-tls.sh
# membangkitkannya, menulisnya ke .env, dan membuat password file broker.
# Jalankan script itu sebelum `docker compose up`.
#
# Di luar compose (dev tanpa Docker), pakai URL ber-TLS juga bisa:
#   mqtts://localhost:8883 atau wss://localhost:443
MQTT_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_MODE="mock"
# Berapa lama (ms) perangkat tetap muncul di hasil scan sejak pesan
# terakhirnya. Tanpa ini, perangkat yang dihapus/dimatikan masih muncul
# sampai API di-restart.
MQTT_DISCOVERY_TTL_MS="120000"

# TLS broker untuk API. Dua env berikut opsional di luar compose:
#   MQTT_TLS_CA_PATH : path file CA yang dibaca API lalu dipakai untuk
#                      memverifikasi sertifikat broker (compose meng-inject
#                      docker/mosquitto/config/ca.crt ke /run/nexahome/mqtt-ca.pem).
#   MQTT_TLS_CA       : isi PEM langsung, kalau file tidak bisa di-mount.
# MQTT_TLS_REJECT_UNAUTHORIZED: true|false. Kosong = biarkan default mqtt.js
# (verifikasi aktif). `false` hanya untuk broker yang sertifikatnya belum
# dipercaya — dan hanya sah pada URL ber-TLS; pada mqtt:// API gagal start.
MQTT_TLS_REJECT_UNAUTHORIZED=""
# MQTT_CA_FILE menunjuk CA untuk healthcheck broker (default
# /mosquitto/config/ca.crt). Hanya perlu diganti kalau memakai sertifikat
# sendiri, lalu file CA-nya di-mount ke broker.
# mTLS (opsional): sertifikat dan kunci klien untuk broker yang mewajibkan
# client certificate.
MQTT_TLS_CERT=""
MQTT_TLS_KEY=""

TASMOTA_MODE="mock"

