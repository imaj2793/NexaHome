# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://nexahome:nexahome@localhost:5432/nexahome?schema=public"

# ── Authentication ──────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── Server ──────────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN="http://localhost:3000"

# ── AI Provider (Phase 3) ───────────────────────────────
# "mock" = provider dummy untuk dev tanpa API key; "openai" = OpenAI-compatible.
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL=""

# ── MQTT ────────────────────────────────────────────────
MQTT_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# ── WiZ ─────────────────────────────────────────────────
WIZ_DISCOVERY_ENABLED="true"
WIZ_MODE="mock"
