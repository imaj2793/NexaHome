# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://nexahome:nexahome@localhost:5432/nexahome?schema=public"

# ── Authentication ──────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── Server ──────────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN="http://localhost:3000"

# ── AI Provider (chat) ──────────────────────────────────
# "mock" = dummy tanpa network; "deepseek"/"openai" = OpenAI-compatible (butuh baseUrl + key).
AI_PROVIDER="mock"
AI_API_KEY=""
AI_BASE_URL="https://api.deepseek.com/v1"
AI_MODEL="deepseek-chat"

# ── STT lokal (Whisper) ─────────────────────────────────
# whisper.cpp dijalankan lokal di CPU (tanpa API eksternal).
WHISPER_BIN="whisper-cli"
WHISPER_MODEL="/path/ke/ggml-base.bin"
WHISPER_LANG="id"

# ── MQTT ────────────────────────────────────────────────
MQTT_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# ── WiZ ─────────────────────────────────────────────────
WIZ_DISCOVERY_ENABLED="true"
WIZ_MODE="mock"
